{
  "hooks": {
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/scripts/capture_compact_handoff.py\"",
            "statusMessage": "Capturing compact handoff"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/scripts/capture_session_skills.py\"",
            "statusMessage": "Capturing session skills"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/scripts/recover_compact_handoff.py\" --post-compact",
            "statusMessage": "Checking compact handoff"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/scripts/recover_compact_handoff.py\"",
            "statusMessage": "Recovering compact handoff"
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/scripts/recover_session_skills.py\"",
            "statusMessage": "Recovering session skills"
          }
        ]
      }
    ]
  }
}
